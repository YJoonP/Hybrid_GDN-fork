ext/
*.zip

# --- large / regenerable datasets (src/prep_data.py); data/gsm8k_256_indices.json stays
data/hotpot_val.jsonl
data/para_pool.json

# --- per-question / per-step raw records of every run (~1 GB); cells/, env, checks and results_compare*/ stay
results_*/raw/
results_superseded/

# --- run-time artifacts
logs/
*.log
*.lock
*_queue*.txt
share/*.tar.gz
